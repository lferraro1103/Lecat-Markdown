{
  "name": "lecat-markdown",
  "version": "3.2.2",
  "description": "Editor y lector Markdown para Windows y macOS, con gráficos sin conexión",
  "main": "electron/main.cjs",
  "author": "Lecat",
  "private": true,
  "scripts": {
    "build": "node electron/build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test electron/core.test.cjs electron/persistence.test.cjs scripts/prepare-electron.test.cjs",
    "audit": "npm run build && electron . --audit",
    "dist": "npm run build && electron-builder --win dir",
    "installer": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:mac:signed": "npm run build && electron-builder --config electron-builder.developer-id.cjs --mac dmg zip --publish never"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-mathematics": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "codemirror": "^6.0.2",
    "dompurify": "^3.2.7",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.10",
    "highlight.js": "^11.11.1",
    "katex": "0.16.22",
    "lucide": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "11.17.2",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "com.lecat.markdown",
    "productName": "Lecat - Markdown",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/core.cjs",
      "electron/macos-locations.cjs",
      "electron/ui/**",
      "branding/**",
      "examples/**",
      "package.json",
      "electron/audit.cjs",
      "src/Assets/audit.md",
      "electron/persistence.cjs",
      "electron/regressions.cjs",
      "electron/visual-audit.cjs"
    ],
    "win": {
      "icon": "branding/Lecat.ico",
      "signAndEditExecutable": true,
      "target": "dir"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "build/LICENCIA.txt",
        "to": "LICENCIA.txt"
      },
      {
        "from": "electron/ui/THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lecat - Markdown",
      "uninstallDisplayName": "Lecat - Markdown",
      "installerIcon": "branding/Lecat.ico",
      "uninstallerIcon": "branding/Lecat.ico",
      "license": "build/LICENCIA.rtf",
      "installerLanguages": [
        "es_ES",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "Lecat-Markdown-${version}-Setup-x64.exe"
    },
    "mac": {
      "icon": "branding/Lecat.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Lecat-Markdown-${version}-macOS-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "role": "Editor"
      }
    ]
  }
}
